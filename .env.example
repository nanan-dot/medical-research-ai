# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DEBUG=true

# 模型路由（openai | ollama | openrouter）
DEFAULT_MODEL_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# 首次加载本地模型可能较慢
OLLAMA_TIMEOUT_SECONDS=120

# PaperQA2（固定版本安装在隔离环境中）
PAPERQA_VERSION=2026.3.18
PAPERQA_EMBEDDING_MODEL=nomic-embed-text
PAPERQA_TIMEOUT_SECONDS=300

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# 云端模型请求超时（秒）
LLM_TIMEOUT_SECONDS=30

# 模型配置密钥（Fernet，首个用于加密，其余用于旧密钥轮换读取；逗号分隔）
MODEL_CONFIG_ENCRYPTION_KEYS=

# PubMed
PUBMED_API_KEY=
PUBMED_EMAIL=
