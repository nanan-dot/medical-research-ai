# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DEBUG=true

# 上传（仅支持 PDF；50 MiB）
UPLOAD_DIR=./uploads
MAX_UPLOAD_PDF_BYTES=52428800
MAX_DOCX_PREVIEW_BYTES=10485760
OCR_OUTPUT_DIR=./data/ocr
OCR_LANGUAGE=eng
OCR_MAX_PAGES=50
OCR_RENDER_SCALE=2.0
# 留空时从 PATH 查找 tesseract.exe
TESSERACT_COMMAND=

# A0 PDF.js TextItem extractor: use the independently installed package, never frontend/node_modules.
# Example (after npm ci && npm run build in tools/pdf_textitem_extractor):
# PDF_TEXTITEM_EXTRACTOR_COMMAND='["node", "D:/AI_project/rag_medicine/tools/pdf_textitem_extractor/dist/cli.js"]'
PDF_TEXTITEM_EXTRACTOR_COMMAND=
PDF_TEXTITEM_EXTRACTOR_TIMEOUT_SECONDS=120
PDF_TEXTITEM_EXTRACTOR_MAX_PAGES=500
PDF_TEXTITEM_EXTRACTOR_MAX_ITEMS_PER_PAGE=50000
PDF_TEXTITEM_EXTRACTOR_MAX_OUTPUT_BYTES=134217728
PDF_TEXTITEM_EXTRACTOR_MAX_FILE_BYTES=104857600
PDF_TEXTITEM_EXTRACTOR_MAX_LINE_BYTES=16777216
PDF_TEXTITEM_EXTRACTOR_IDLE_TIMEOUT_SECONDS=30

# PMC 官方案可验证开放全文（仅从 OAI + OA Web Service 获取）
OPEN_FULLTEXT_DIR=./data/open_fulltext
MAX_OPEN_FULLTEXT_PDF_BYTES=104857600
PMC_REQUEST_TIMEOUT_SECONDS=30
PMC_DOWNLOAD_TIMEOUT_SECONDS=90
# 建议填写 NCBI 联系邮箱，便于官方服务识别请求来源
PMC_CONTACT_EMAIL=

# 模型路由（openai | ollama | openrouter）
DEFAULT_MODEL_PROVIDER=ollama

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# 首次加载本地模型可能较慢
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=ollama

# Mini-RAG 笔记检索（R2-WP09）
# 本地优先：ollama 失败时用 dummy 兜底（开发用，非语义向量），不切换云端
EMBEDDING_PROVIDER=dummy
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=384

# Retrieval profiles are baseline defaults, not evidence of optimal quality.
# SEARCH_TOP_K is legacy compatibility only; explicit stage settings take priority.
RETRIEVAL_PROFILE=local_evidence
DENSE_TOP_K=
SPARSE_TOP_K=
FUSION_TOP_K=
RERANK_TOP_K=
LLM_CONTEXT_TOP_K=
RRF_K=60
RERANK_ENABLED=false
NAVIGATION_RERANK_ENABLED=false
NAVIGATION_RERANK_MODEL_DIR=
NAVIGATION_RERANK_INITIALIZATION_TIMEOUT_SECONDS=60
NAVIGATION_RERANK_TIMEOUT_SECONDS=30
NAVIGATION_DENSE_TOP_K=30
NAVIGATION_SPARSE_TOP_K=30
NAVIGATION_FUSION_TOP_K=40
NAVIGATION_RERANK_CANDIDATE_TOP_K=40
# Grounded RAG is disabled by default; paperqa preserves the existing answer path.
GROUNDED_RAG_MODE=paperqa
GROUNDED_RAG_ENABLED=false

# RAG trace 审计：默认关闭且最小化采集。仅在明确合规授权后才保存问题或文献正文。
# 所有 trace 文件限制在 DATA_DIR（可选子目录 RAG_TRACE_DIR）中；应用内按保留期清理，
# 不会创建系统计划任务或修改系统日志服务。
RAG_TRACE_ENABLED=false
RAG_TRACE_DIR=
RAG_TRACE_STORE_QUERY=false
RAG_TRACE_STORE_TEXT=false
RAG_TRACE_MAX_CANDIDATES=50
RAG_TRACE_MAX_TEXT_CHARS=500
RAG_TRACE_RETENTION_DAYS=30
# Formal medical Shadow: remains unapproved until an authorized budget is frozen.
MEDICAL_SHADOW_PERFORMANCE_BUDGET_APPROVED=false
MEDICAL_SHADOW_PERFORMANCE_BUDGET_SOURCE=

# PaperQA2（固定版本安装在隔离环境中）
PAPERQA_VERSION=2026.3.18
PAPERQA_EMBEDDING_MODEL=nomic-embed-text
PAPERQA_TIMEOUT_SECONDS=300

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# 云端模型请求超时（秒）
LLM_TIMEOUT_SECONDS=30

# 模型配置密钥（Fernet，首个用于加密，其余用于旧密钥轮换读取；逗号分隔）
MODEL_CONFIG_ENCRYPTION_KEYS=

# 离线英中医学翻译（模型资产须预先下载，运行时不会联网）
MEDICAL_TRANSLATION_LOCAL_MODEL_DIR=
MEDICAL_TRANSLATION_LOCAL_TOKENIZER_DIR=
MEDICAL_TRANSLATION_LOCAL_DEVICE=auto
MEDICAL_TRANSLATION_ENGINE=auto
MEDICAL_TERMINOLOGY_INDEX_PATH=
MEDICAL_TRANSLATION_LOCAL_CPU_THREADS=2
MEDICAL_TRANSLATION_TIMEOUT_SECONDS=600

# PubMed
# NCBI E-utilities API Key（可选，但建议申请：https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/）
# 有 Key 时限流放宽到 10 req/s；无 Key 时按 3 req/s 保守节流。
PUBMED_API_KEY=
# 必填：NCBI 要求提供联系方式邮箱，否则请求可能被 403 拒绝。
PUBMED_EMAIL=
# Maximum UTF-8 journal metric CSV upload size (32 MiB by default).
JOURNAL_METRIC_IMPORT_MAX_BYTES=33554432
