{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2024", "DOM"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true, "noUnusedLocals": true,
    "skipLibCheck": true, "outDir": "dist", "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
